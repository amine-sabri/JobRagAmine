# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- JobRAG's own Postgres (pgvector), created by docker/docker-compose.yml ---
JOBRAG_DB_PASSWORD=change-me
JOBRAG_DB_DSN=postgresql://jobrag:change-me@127.0.0.1:55433/jobrag

# --- JobCrusader source database: READ-ONLY role only (see README) ---
# Left empty until phase 1. Must be the jobrag_ro role, never the app's own user.
SOURCE_DB_DSN=

# --- Models ---
# No GPU on this machine (checked with nvidia-smi), so: the smaller multilingual
# embedding model. bge-m3 is kept as a phase-9 comparison.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Generation (local LLM, swappable) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
